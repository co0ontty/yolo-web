# Vibe Coding 配置文件
# 复制此文件为 .env 并修改相应配置

# ==================== Web 认证配置 ====================
# 启用 Web 访问认证（true/false）
WEB_AUTH_ENABLED=false

# Web 认证用户名（默认：admin）
WEB_AUTH_USER=admin

# Web 认证密码（必填，启用认证时设置）
# 建议使用强密码，例如：WEB_AUTH_PASSWORD=your-secure-password-123
WEB_AUTH_PASSWORD=

# ==================== Claude API 配置 ====================
# Claude API Token（可选，也可在会话中单独设置）
# CLAUDE_TOKEN=sk-ant-xxxxx

# ==================== 其他配置 ====================
# 服务器端口（默认：3100）
PORT=3100
